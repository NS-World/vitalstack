+	.tool[data-tool="sample-size-calculator"]:not([data-ready]) { min-height: 580px; }
+	.tool[data-tool="ai-cost-calculator"]:not([data-ready]) { min-height: 750px; }
+	.tool[data-tool="csv-data-explorer"]:not([data-ready]) { min-height: 1300px; }
+	.tool[data-tool="prompt-builder"]:not([data-ready]) { min-height: 730px; }
