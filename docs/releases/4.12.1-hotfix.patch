+			ctx.save(); ctx.shadowColor = 'rgba(224,231,255,.7)'; ctx.shadowBlur = 14; ctx.fillStyle = '#e0e7ff'; ctx.beginPath(); ctx.arc(W - 160, 34, 10, 0, Math.PI * 2); ctx.fill(); ctx.restore();
+			ctx.fillStyle = C.sky1; ctx.beginPath(); ctx.arc(W - 155, 30, 9, 0, Math.PI * 2); ctx.fill();
+			// stars twinkle
+			stars.forEach(function (s) { if ((Math.sin(frameT * 2 + s.p) + 1) > 0.4) px(s.x, s.y, s.s, s.s, C.star); });
+			// far skyline: server towers with lit windows (slow parallax)
+			var fo = (dist * 0.12) % (W + 120);
+			towers.forEach(function (t) {
+				var x = ((t.x - fo) % (W + 120) + W + 120) % (W + 120) - 60;
+				px(x, GROUND - t.h, t.w, t.h, C.far);
+				for (var wy = GROUND - t.h + 6; wy < GROUND - 6; wy += 8) for (var wx = x + 4; wx < x + t.w - 4; wx += 6) if (((wx * 7 + wy * 3) | 0) % 5 === 0) px(wx, wy, 2, 3, C.farWin);
+			});
+			// mid hills (faster parallax)
+			var mo = (dist * 0.35) % (W + 200);
+			hills.forEach(function (h) {
+				var x = ((h.x - mo) % (W + 200) + W + 200) % (W + 200) - 100;
+				for (var i = 0; i < 6; i++) px(x + i * h.w / 12, GROUND - h.h + i * h.h / 6, h.w - i * h.w / 6, h.h / 6 + 1, C.mid);
+			});
+			// ground: glowing line of code
+			px(-10, GROUND, W + 20, H - GROUND, C.ground);
+			px(-10, GROUND - 1, W + 20, 3, C.lineGlow); px(-10, GROUND, W + 20, 1, C.line);
+			ctx.font = '10px ui-monospace, monospace'; ctx.textAlign = 'left'; ctx.fillStyle = C.token;
+			var off = dist % 70;
+			for (var i = 0, x2 = -off; x2 < W + 70; x2 += 70, i++) ctx.fillText(GROUND_WORDS[(i + Math.floor(dist / 70)) % GROUND_WORDS.length], x2, GROUND + 18);
+			var off2 = (dist * 1.3) % 26;
+			for (var x3 = -off2; x3 < W; x3 += 26) px(x3, GROUND + 28, 8, 2, C.token);
+		}
+		function hud() {
+			ctx.font = '600 12px ui-monospace, monospace'; ctx.textAlign = 'right'; ctx.fillStyle = C.hud;
+			ctx.fillText('SCORE ' + String(score()).padStart(5, '0'), W - 12, 20);
+			ctx.fillStyle = C.hudDim; ctx.fillText('BEST ' + String(hiscore).padStart(5, '0'), W - 12, 36);
+			if (state !== 'run') {
+				ctx.textAlign = 'center'; ctx.fillStyle = C.white; ctx.font = 'bold 18px ui-monospace, monospace';
+				ctx.fillText(state === 'over' ? 'GAME OVER' : state === 'paused' ? 'PAUSED' : 'BUG RUNNER', W / 2, H * 0.34);
+				ctx.font = '12px ui-monospace, monospace'; ctx.fillStyle = C.hud;
+				ctx.fillText(state === 'paused' ? 'Tap or press space to go on' : 'Tap or press space to ' + (state === 'over' ? 'restart' : 'start'), W / 2, H * 0.34 + 20);
+			}
+		}
+		function draw() {
+			if (!cat) reset();
+			ctx.setTransform(dpr * scale, 0, 0, dpr * scale, 0, 0);
+			ctx.imageSmoothingEnabled = false;
+			ctx.save(); if (shake > 0) ctx.translate((Math.random() - 0.5) * 6, 0);
+			drawScene();
+			coins.forEach(drawCoin);
+			obs.forEach(function (o) { if (o.k === 'bug') drawBug(o); else if (o.k === 'rack') drawRack(o); else drawGlitch(o); });
+			drawHero(cat.x, cat.y, state === 'over');
+			sparks.forEach(function (s) { px(s.x, s.y, 3, 3, s.c); });
+			hud();
+			ctx.restore();
+		}
+		function loop(now) {
+			if (state !== 'run') return;
+			var dt = Math.min(0.033, (now - last) / 1000); last = now;
+			step(dt);
+			if (state === 'run') { draw(); paintScore(); raf = requestAnimationFrame(loop); }
+		}
+
+		reset(); resize(); paintScore();
+		if (window.ResizeObserver) new ResizeObserver(function () { resize(); }).observe(box);
+		else window.addEventListener('resize', resize);
+		box.classList.add('is-ready');
+	}
+
+	function init() { document.querySelectorAll('[data-runner]').forEach(mount); }
+	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
+	window.VSRunner = { mount: mount };
+})();
