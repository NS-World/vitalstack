+/* ── Bug Runner game (games page and 404) ──────────────────────────────── */
+.vs-runner { max-width: 960px; margin: 0 auto; border: 1px solid var(--border); border-radius: 18px; background: var(--surface); box-shadow: var(--shadow-md); overflow: hidden; }
