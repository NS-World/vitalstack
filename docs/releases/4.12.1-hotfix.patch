+/* ── 4.12.1 layout-shift fixes ─────────────────────────────────────────── */
+/* Phones: the tool status (Loading…, Ready, errors) gets its own line, so a
+   longer message never re-wraps the buttons and moves the page. */
+@media (max-width: 599px) { .tool-bar > .tool-status { flex: 1 1 100%; margin-left: 0; min-height: 1.5em; } }
+/* Tools are drawn by JavaScript: reserve about their height first so the
+   guide text below does not jump (layout shift). Heights are measured per
+   tool; the reservation ends once the tool is ready (data-ready). */
+.tool[data-tool="python-online-compiler"]:not([data-ready]) { min-height: 940px; }
+.tool[data-tool="sql-playground"]:not([data-ready]) { min-height: 580px; }
+.tool[data-tool="json-formatter"]:not([data-ready]) { min-height: 910px; }
+.tool[data-tool="regex-tester"]:not([data-ready]) { min-height: 980px; }
+.tool[data-tool="html-online-editor"]:not([data-ready]) { min-height: 1650px; }
+.tool[data-tool="ab-test-calculator"]:not([data-ready]) { min-height: 990px; }
+.tool[data-tool="sample-size-calculator"]:not([data-ready]) { min-height: 820px; }
+.tool[data-tool="ai-cost-calculator"]:not([data-ready]) { min-height: 1680px; }
+.tool[data-tool="csv-data-explorer"]:not([data-ready]) { min-height: 2310px; }
+.tool[data-tool="prompt-builder"]:not([data-ready]) { min-height: 1220px; }
+@media (min-width: 600px) {
+	.tool[data-tool="python-online-compiler"]:not([data-ready]) { min-height: 870px; }
+	.tool[data-tool="sql-playground"]:not([data-ready]) { min-height: 510px; }
+	.tool[data-tool="json-formatter"]:not([data-ready]) { min-height: 870px; }
+	.tool[data-tool="regex-tester"]:not([data-ready]) { min-height: 900px; }
+	.tool[data-tool="html-online-editor"]:not([data-ready]) { min-height: 1620px; }
+	.tool[data-tool="ab-test-calculator"]:not([data-ready]) { min-height: 680px; }
+	.tool[data-tool="sample-size-calculator"]:not([data-ready]) { min-height: 640px; }
+	.tool[data-tool="ai-cost-calculator"]:not([data-ready]) { min-height: 960px; }
+	.tool[data-tool="csv-data-explorer"]:not([data-ready]) { min-height: 1600px; }
+	.tool[data-tool="prompt-builder"]:not([data-ready]) { min-height: 1180px; }
+}
+@media (min-width: 1024px) {
+	.tool[data-tool="python-online-compiler"]:not([data-ready]) { min-height: 620px; }
+	.tool[data-tool="sql-playground"]:not([data-ready]) { min-height: 430px; }
