+/**
+ * VitalStack Assistant (4.13.4): instant answers about courses, prices,
+ * offers, certificates and payments.
+ *
+ * Runs fully in the browser from the public facts in #vsa-data. Nothing the
+ * visitor types is sent anywhere. Replies are built with textContent and
+ * same-site links only, so typed text can never become HTML or script.
+ * English and Hinglish questions both work ("price kitna hai", "refund milega?").
+ *
+ * @package VitalStack
+ */
+(function () {
+	'use strict';
+
+	var fab = document.querySelector('[data-vsa-open]');
+	var panel = document.querySelector('[data-vsa-panel]');
+	var raw = document.getElementById('vsa-data');
+	if (!fab || !panel || !raw) return;
+	var D;
+	try { D = JSON.parse(raw.textContent); } catch (e) { return; }
+	var log = panel.querySelector('[data-vsa-log]'), chipsBox = panel.querySelector('[data-vsa-chips]');
+	var form = panel.querySelector('[data-vsa-form]'), input = panel.querySelector('[data-vsa-input]');
+	var U = D.urls || {};
+	fab.hidden = false;
+
+	/* ── Currency: same rule as the pricing page (₹ in India, $ elsewhere) ─ */
+	var cur = D.cur === 'inr' || D.cur === 'usd' ? D.cur : null;
+	if (!cur) {
+		var tz = '';
+		try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
+		cur = /^Asia\/(Kolkata|Calcutta)$/.test(tz) ? 'inr' : 'usd';
+	}
+	function money(n) {
+		if (cur === 'inr') return '₹' + Math.round(n).toLocaleString('en-IN');
+		return '$' + (Math.round(n * 100) % 100 ? n.toFixed(2) : String(Math.round(n)));
+	}
+	function plan(kind) { for (var i = 0; i < (D.plans || []).length; i++) if (D.plans[i].kind === kind) return D.plans[i]; return null; }
+	function price(p) { return p ? p[cur] : 0; }
+	function was(p) { var w = p ? (cur === 'inr' ? p.wasInr : p.wasUsd) : 0; return w > price(p) ? w : 0; }
+	function save(p) { var w = was(p); return w ? Math.round((1 - price(p) / w) * 100) : 0; }
+	var Y = plan('year'), M = plan('month'), T = plan('track'), L = plan('life'), C = plan('combo');
+	var nTracks = (D.tracks || []).length || (Y ? Y.tracks : 3);
+	var buyLabel = D.open ? 'See plans' : 'Join the waitlist';
+
+	/* ── Message model: strings, {b: bold}, {list: [...]}, buttons ─────────── */
+	function link(t, u) { return u ? { t: t, u: u } : null; }
+	function act(t, a) { return { t: t, a: a }; }
+	function safeUrl(u) {
+		try { var x = new URL(u, location.href); return (x.origin === location.origin && /^https?:$/.test(x.protocol)) ? x.href : ''; } catch (e) { return ''; }
+	}
