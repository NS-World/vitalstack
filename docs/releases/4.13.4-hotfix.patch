+		var row = document.createElement('div');
+		row.className = 'vsa-msg ' + (msg.me ? 'is-me' : 'is-bot');
+		var bub = document.createElement('div'); bub.className = 'vsa-bubble';
+		(msg.parts || []).forEach(function (part) {
+			if (typeof part === 'string') { var p = document.createElement('p'); p.textContent = part; bub.appendChild(p); return; }
+			if (part.list) {
+				var ul = document.createElement('ul');
+				part.list.forEach(function (li) {
+					var el = document.createElement('li');
+					if (typeof li === 'string') el.textContent = li;
+					else { var b = document.createElement('b'); b.textContent = li[0]; el.appendChild(b); el.appendChild(document.createTextNode(li[1])); }
+					ul.appendChild(el);
+				});
+				bub.appendChild(ul);
+				return;
+			}
+			if (part.b) { var bp = document.createElement('p'); var bb = document.createElement('b'); bb.textContent = part.b; bp.appendChild(bb); if (part.rest) bp.appendChild(document.createTextNode(part.rest)); bub.appendChild(bp); }
