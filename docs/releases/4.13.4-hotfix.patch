+	$s['on'] = ! empty( $_POST['on'] );
+	foreach ( array( 'percent', 'paid_days', 'active_need', 'active_days', 'cap_paid', 'cap_active' ) as $k ) {
+		if ( isset( $_POST[ $k ] ) ) {
