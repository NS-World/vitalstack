+		// Clicking elsewhere on the page (another game, a link) pauses the run.
+		document.addEventListener('pointerdown', function (e) { if (state === 'run' && !box.contains(e.target)) pause(); }, true);
+		document.addEventListener('visibilitychange', function () { if (document.hidden && state === 'run') pause(); });
+		window.addEventListener('blur', function () { if (state === 'run') pause(); });
+
+		function say(t) { msgEl.textContent = t; }
+		function score() { return Math.floor(dist / 12) + bonus; }
+		function paintScore() { scoreEl.textContent = 'Score ' + score() + ' · Best ' + hiscore; }
+		function start() {
+			reset(); state = 'run'; box.classList.add('is-running'); playBtn.hidden = true;
+			say(TIPS[Math.floor(Math.random() * TIPS.length)]);
+			last = performance.now(); cancelAnimationFrame(raf); raf = requestAnimationFrame(loop);
+		}
+		function pause() { state = 'paused'; box.classList.remove('is-running'); playBtn.hidden = false; playBtn.textContent = '▶ Resume'; say('Paused.'); draw(); }
