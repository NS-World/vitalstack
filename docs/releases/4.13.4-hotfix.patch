+			else if (r < 0.55) o = { k: 'bug', w: 30, h: 18, y: GROUND - 18 };
+			else { var n = Math.random() < 0.3 + lvl * 0.3 ? 2 : 1; o = { k: 'rack', w: 24, h: 24 * n, y: GROUND - 24 * n, n: n }; }
+			o.x = W + 20; obs.push(o);
+			if (o.k === 'bug' && Math.random() < 0.2 + lvl * 0.2) obs.push({ k: 'bug', w: 30, h: 18, y: GROUND - 18, x: W + 20 + 36 });
+			var gap = 0.8 + Math.random() * 0.9 - lvl * 0.25;
+			spawnIn = Math.max(0.6, gap) * (300 / speed) * 1.25;
+		}
