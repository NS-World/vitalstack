+		}
+		function scenery() {
+			var i;
+			stars = []; for (i = 0; i < Math.round(W / 14); i++) stars.push({ x: Math.random() * W, y: Math.random() * 95, s: Math.random() < 0.2 ? 2 : 1, p: Math.random() * 6 });
+			towers = []; for (var x = 0; x < W + 120; x += 34 + Math.random() * 30) towers.push({ x: x, w: 22 + Math.random() * 18, h: 34 + Math.random() * 46 });
+			hills = []; for (var hx = 0; hx < W + 200; hx += 90 + Math.random() * 60) hills.push({ x: hx, w: 120 + Math.random() * 90, h: 16 + Math.random() * 18 });
+		}
