+/**
+ * Bug Runner: an endless runner starring Byte, the crew's orange cat with
+ * green headphones. Run along a glowing line of code at night, jump over
+ * bugs and 500-error server racks, dodge flying glitches and collect coffee
+ * and { } coins. Space / ↑ / tap to jump (hold for higher, tap again in the
+ * air for a double jump), ↓ to drop faster, Esc to pause.
+ *
+ * Mounts on every [data-runner] box (games page and the 404 page). Pixel art
+ * is drawn on a canvas, sharp on any screen. The best score is kept on this
+ * device only. Nothing is sent anywhere, except XP through window.VS on the
+ * games page when the site provides it.
+ */
+(function () {
+	'use strict';
+
+	var JOKES = [
+		'Byte tripped over a NullPointerException.',
+		'Uncaught BugError: runner hit a bug at line 404.',
+		'Segmentation fault (cat dumped).',
+		'Error 500: Byte needs more coffee.',
+		'Merge conflict with a server rack.',
+		'Stack overflow: too many bugs on the stack.',
+		'Infinite loop detected. Just kidding, you crashed.',
+		'"It works on my machine," said Byte.'
+	];
+	var TIPS = [
+		'Tip: hold jump to go higher.',
+		'Tip: tap again in the air for a double jump.',
+		'Tip: press ↓ to land faster.',
+		'Tip: ☕ = +25 points, { } = +10.'
+	];
+	var CHEERS = ['Nice streak!', 'Byte is on fire.', 'Bugs fear you.', 'Senior runner energy.', 'Zero downtime!', 'Ship it!'];
+	var GROUND_WORDS = ['if', '{ }', '0101', 'for', '=>', 'def', '</>', 'SELECT', 'npm', '[]', '&&', 'git', '++', 'null'];
+
+	// Fixed "night terminal" palette: the game looks the same in every theme.
+	var C = {
+		sky1: '#0d1020', sky2: '#1c1f3d', star: '#c7d2fe', far: '#1f2547', farWin: '#3b4687', mid: '#272d5a',
+		ground: '#0a0c16', line: '#7c6cff', lineGlow: 'rgba(124,108,255,.35)', token: '#3a4070',
+		hud: '#c7cbe0', hudDim: '#7d84a8', white: '#ffffff',
+		cat: '#f59e0b', catDark: '#c2410c', catOut: '#1f1300', belly: '#fff7ed', phones: '#10b981', phonesDark: '#047857', nose: '#f472b6',
+		bug: '#ef4444', bugDark: '#7f1d1d', bugSpot: '#fde68a',
+		rack: '#cbd5e1', rackDark: '#334155', rackLine: '#64748b', led1: '#ef4444', led2: '#f59e0b',
+		glitch: '#a855f7', glitch2: '#22d3ee', coin: '#34d399', cup: '#f5f5f4', coffee: '#78350f', spark: '#a5b4fc'
+	};
+
+	function best(v) {
+		try { if (v === undefined) return +(localStorage.getItem('vs-runner-best') || 0) || 0; localStorage.setItem('vs-runner-best', String(v)); } catch (e) { return 0; }
+		return v;
+	}
+
+	function mount(box) {
+		if (box.getAttribute('data-ready')) return;
+		box.setAttribute('data-ready', '1');
+		var canvas = box.querySelector('canvas'), ctx = canvas.getContext('2d');
+		var scoreEl = box.querySelector('[data-runner-score]'), msgEl = box.querySelector('[data-runner-msg]');
+		var playBtn = box.querySelector('[data-runner-play]'), soundBtn = box.querySelector('[data-runner-sound]');
+		var context = box.getAttribute('data-context') || 'games';
+		var H = 200, W = 600, scale = 1, dpr = 1; // world units: 200 tall, width follows the box
+		var GROUND = 162, U = 2;                   // U: size of one sprite pixel in world units
+		var state = 'idle', raf = 0, last = 0, speed = 0, dist = 0, bonus = 0, hiscore = best(), shake = 0, cheers = 0, awarded = false;
+		var cat, obs, coins, sparks, stars, towers, hills, spawnIn, coinIn, frameT = 0;
+		var keyDown = false, sound = false, audio = null;
+
+		/* ── Size: fill the box width; taller on phones ── */
+		function resize() {
+			var w = Math.max(240, box.clientWidth);
+			var h = Math.round(Math.min(280, Math.max(190, w < 600 ? w * 0.62 : w * 0.3)));
+			dpr = Math.min(2, window.devicePixelRatio || 1);
+			canvas.style.height = h + 'px';
+			canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
+			scale = h / H; W = w / scale;
+			scenery();
