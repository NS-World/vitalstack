+		'active'  => count( vitalstack_ref_active_friends( $user_id ) ),
+		'paid'    => count( $orders['settled'] ) + count( $orders['pending'] ),
+		'pending' => count( $orders['pending'] ),
+		'days'    => array_sum( wp_list_pluck( $log, 'days' ) ),
+	);
+}
