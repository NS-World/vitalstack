+			} catch (e) {}
+		}
+		function burst(x, y, n, c, sp) { for (var i = 0; i < n; i++) sparks.push({ x: x, y: y, vx: (Math.random() - 0.5) * sp, vy: -Math.random() * sp * 0.7, t: 0.45, c: c }); }
+
+		/* ── Input ── */
+		function jump() {
+			if (state === 'idle' || state === 'over') { start(); return; }
+			if (state === 'paused') { resume(); return; }
+			if (cat.onGround || cat.jumps < 2) {
+				var first = cat.onGround;
+				cat.vy = first ? -600 : -500; cat.onGround = false; cat.jumps++; cat.hold = 0.17;
+				beep(first ? 420 : 640, 0.09);
+				burst(cat.x + 10, cat.y, 5, C.spark, 140);
