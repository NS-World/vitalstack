+/* Interview problems: Python | Java | C++ | JavaScript tabs (4.17.0).
+ * Turns each [data-sol-tabs] block into accessible tabs (arrow keys, Home/End)
+ * and remembers the learner's language on this device. */
+(function () {
+	'use strict';
+	var KEY = 'vs-sol-lang';
+	function saved() { try { return localStorage.getItem(KEY) || ''; } catch (e) { return ''; } }
+	function save(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }
+
+	function build(box) {
+		if (box.getAttribute('data-sol-ready')) return;
+		var panels = Array.prototype.slice.call(box.querySelectorAll(':scope > .sol-panel'));
+		if (panels.length < 2) return;
+		box.setAttribute('data-sol-ready', '1');
+		var list = document.createElement('div');
+		list.className = 'sol-tablist';
+		list.setAttribute('role', 'tablist');
+		list.setAttribute('aria-label', 'Solution language');
+		var tabs = panels.map(function (p, i) {
+			var lang = p.getAttribute('data-sol-lang');
+			var t = document.createElement('button');
+			t.type = 'button';
+			t.className = 'sol-tab';
+			t.id = box.id + '-t-' + lang;
+			t.setAttribute('role', 'tab');
+			t.setAttribute('data-lang', lang);
+			t.textContent = p.getAttribute('data-sol-label') || lang;
+			p.id = box.id + '-p-' + lang;
+			p.setAttribute('role', 'tabpanel');
+			p.setAttribute('aria-labelledby', t.id);
+			t.setAttribute('aria-controls', p.id);
+			t.addEventListener('click', function () { show(lang, true); });
+			t.addEventListener('keydown', function (e) {
+				var j = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : null;
+				if (j === null) return;
+				e.preventDefault();
+				j = (j + tabs.length) % tabs.length;
+				tabs[j].focus();
+				show(tabs[j].getAttribute('data-lang'), true);
+			});
+			list.appendChild(t);
+			return t;
+		});
+		box.insertBefore(list, panels[0]);
+		box.classList.add('is-tabs');
+
+		function show(lang, remember) {
+			var found = panels.some(function (p) { return p.getAttribute('data-sol-lang') === lang; });
+			if (!found) lang = panels[0].getAttribute('data-sol-lang');
+			panels.forEach(function (p, k) {
+				var on = p.getAttribute('data-sol-lang') === lang;
+				p.hidden = !on;
+				tabs[k].setAttribute('aria-selected', on ? 'true' : 'false');
+				tabs[k].tabIndex = on ? 0 : -1;
+			});
+			if (remember) {
+				save(lang);
+				document.querySelectorAll('[data-sol-tabs].is-tabs').forEach(function (other) {
+					if (other !== box && other.vsSolShow) other.vsSolShow(lang, false);
+				});
+			}
+		}
+		box.vsSolShow = show;
+		show(saved() || 'python', false);
+	}
+
+	function init() { document.querySelectorAll('[data-sol-tabs]').forEach(build); }
+	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
+	else init();
+	document.addEventListener('vs:lesson-loaded', init);
+})();
