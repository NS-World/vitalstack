+.pg-log.is-error { color: #b42318; } .pg-log.is-warn { color: #b26b00; }
+.pg-help { padding-top: 10px; padding-bottom: 40px; }
+.pg-help ul { padding-left: 20px; color: var(--text-2); }
+@media (max-width: 899px) {
+	.pg-mobile-tabs { display: flex; }
+	.pg-main { grid-template-columns: minmax(0, 1fr); height: 72vh; height: 72dvh; }
+	.pg-main[data-view="code"] .pg-view, .pg-main[data-view="preview"] .pg-code { display: none; }
+	.pg-sp { display: none; }
+}
+
+/* ── 4.17.0: interview solutions in Python, Java, C++ and JavaScript ── */
+.sol-tabs { margin: 0 0 24px; }
+.sol-note { margin: 0 0 10px; font-size: 14px; color: var(--text-2); }
+.sol-lab { margin: 14px 0 6px; font-weight: 800; font-size: 14px; color: var(--text); }
+.sol-tabs.is-tabs .sol-lab { display: none; }
+.sol-tablist { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 10px; }
+.sol-tab { min-height: 40px; padding: 8px 16px; border: 1px solid var(--border-strong); border-radius: 999px; background: var(--surface); color: var(--text); font: 700 14px/1.2 var(--font-sans); cursor: pointer; transition: background .15s, border-color .15s, color .15s; }
+.sol-tab:hover { border-color: var(--brand); color: var(--brand-ink); }
+.sol-tab[aria-selected="true"] { background: var(--brand); border-color: var(--brand); color: var(--on-brand, #fff); }
+.sol-tab:focus-visible { outline: 2px solid var(--focus, var(--brand)); outline-offset: 2px; }
+.sol-panel > pre { margin-top: 0; }
+.sol-panel[hidden] { display: none; }
+@media (max-width: 480px) { .sol-tab { flex: 1 1 calc(50% - 6px); padding: 8px 10px; } }
+@media print { .sol-tablist { display: none; } .sol-tabs.is-tabs .sol-lab { display: block; } .sol-panel[hidden] { display: block; } }
+
+/* ── 4.19.0: home hero aside (learning card + landing offer) ── */
+.home-hero-aside { display: grid; gap: 20px; min-width: 0; align-content: center; }
+.home-hero-aside > .hero-card { width: 100%; }
+#plans { scroll-margin-top: 90px; }
+
+/* ── 4.20.0: one device at a time (sign-in popups) ── */
+html.vss-open { overflow: hidden; }
+.vss { position: fixed; inset: 0; z-index: 10000; display: grid; place-items: center; padding: 16px; background: rgba(15, 20, 30, .62); backdrop-filter: blur(3px); animation: vss-in .2s ease; }
+.vss-card { width: min(440px, 100%); max-height: calc(100vh - 32px); overflow: auto; padding: 26px 24px 20px; border-radius: 20px; background: var(--surface, #fff); color: var(--text, #1b1f27); box-shadow: 0 30px 80px rgba(0, 0, 0, .35); text-align: center; }
+.vss-icon { margin: 0 0 6px; font-size: 40px; line-height: 1; }
+.vss-title { margin: 0 0 10px; font-size: 21px; line-height: 1.3; }
+.vss-text { margin: 0 0 10px; font-size: 15px; line-height: 1.55; color: var(--text-2, #444); }
+.vss-text b { color: var(--text, #1b1f27); }
+.vss-actions { display: grid; gap: 10px; margin-top: 16px; }
+.vss-go { width: 100%; justify-content: center; min-height: 46px; }
+.vss-link { font-size: 14px; color: var(--muted, #667085); }
+.vss-go:focus-visible, .vss-link:focus-visible { outline: 3px solid var(--focus, #2563eb); outline-offset: 2px; }
+@keyframes vss-in { from { opacity: 0; } to { opacity: 1; } }
+@media (prefers-reduced-motion: reduce) { .vss { animation: none; } }
+@media print { .vss { display: none !important; } }
