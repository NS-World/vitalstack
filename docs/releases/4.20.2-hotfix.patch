+			if (f) { px(x, y, 10, 4, C.glitch); px(x + 20, y, 10, 4, C.glitch); } else { px(x, y + 10, 10, 4, C.glitch); px(x + 20, y + 10, 10, 4, C.glitch); }
+			px(x + 4 + (f ? 3 : 0), y + 15, 4, 2, C.glitch2); px(x + 20 - (f ? 3 : 0), y + 2, 4, 2, C.glitch2);
+		}
+		function drawCoin(c) {
+			var bob = Math.sin(frameT * 5 + c.x * 0.05) * 2;
+			ctx.save(); ctx.shadowColor = c.k === 'cup' ? 'rgba(255,255,255,.6)' : 'rgba(52,211,153,.8)'; ctx.shadowBlur = 8;
+			if (c.k === 'cup') {
+				px(c.x + 2, c.y + 5 + bob, 11, 11, C.cup); px(c.x + 2, c.y + 5 + bob, 11, 3, C.coffee); px(c.x + 13, c.y + 8 + bob, 3, 5, C.cup);
+				px(c.x + 5, c.y + bob, 1, 3, C.hudDim); px(c.x + 9, c.y - 1 + bob, 1, 3, C.hudDim);
+			} else {
+				ctx.fillStyle = C.coin; ctx.font = 'bold 14px ui-monospace, monospace'; ctx.textAlign = 'center';
+				ctx.fillText('{ }', c.x + 8, c.y + 13 + bob);
+			}
+			ctx.restore();
+		}
+		function drawScene() {
+			var g = ctx.createLinearGradient(0, 0, 0, GROUND);
+			g.addColorStop(0, C.sky1); g.addColorStop(1, C.sky2);
+			ctx.fillStyle = g; ctx.fillRect(-10, 0, W + 20, GROUND);
+			// moon
+			ctx.save(); ctx.shadowColor = 'rgba(224,231,255,.7)'; ctx.shadowBlur = 14; ctx.fillStyle = '#e0e7ff'; ctx.beginPath(); ctx.arc(W - 160, 34, 10, 0, Math.PI * 2); ctx.fill(); ctx.restore();
+			ctx.fillStyle = C.sky1; ctx.beginPath(); ctx.arc(W - 155, 30, 9, 0, Math.PI * 2); ctx.fill();
+			// stars twinkle
+			stars.forEach(function (s) { if ((Math.sin(frameT * 2 + s.p) + 1) > 0.4) px(s.x, s.y, s.s, s.s, C.star); });
+			// far skyline: server towers with lit windows (slow parallax)
+			var fo = (dist * 0.12) % (W + 120);
+			towers.forEach(function (t) {
+				var x = ((t.x - fo) % (W + 120) + W + 120) % (W + 120) - 60;
+				px(x, GROUND - t.h, t.w, t.h, C.far);
+				for (var wy = GROUND - t.h + 6; wy < GROUND - 6; wy += 8) for (var wx = x + 4; wx < x + t.w - 4; wx += 6) if (((wx * 7 + wy * 3) | 0) % 5 === 0) px(wx, wy, 2, 3, C.farWin);
+			});
+			// mid hills (faster parallax)
+			var mo = (dist * 0.35) % (W + 200);
+			hills.forEach(function (h) {
+				var x = ((h.x - mo) % (W + 200) + W + 200) % (W + 200) - 100;
+				for (var i = 0; i < 6; i++) px(x + i * h.w / 12, GROUND - h.h + i * h.h / 6, h.w - i * h.w / 6, h.h / 6 + 1, C.mid);
+			});
+			// ground: glowing line of code
+			px(-10, GROUND, W + 20, H - GROUND, C.ground);
+			px(-10, GROUND - 1, W + 20, 3, C.lineGlow); px(-10, GROUND, W + 20, 1, C.line);
+			ctx.font = '10px ui-monospace, monospace'; ctx.textAlign = 'left'; ctx.fillStyle = C.token;
+			var off = dist % 70;
+			for (var i = 0, x2 = -off; x2 < W + 70; x2 += 70, i++) ctx.fillText(GROUND_WORDS[(i + Math.floor(dist / 70)) % GROUND_WORDS.length], x2, GROUND + 18);
+			var off2 = (dist * 1.3) % 26;
+			for (var x3 = -off2; x3 < W; x3 += 26) px(x3, GROUND + 28, 8, 2, C.token);
+		}
+		function hud() {
+			ctx.font = '600 12px ui-monospace, monospace'; ctx.textAlign = 'right'; ctx.fillStyle = C.hud;
+			ctx.fillText('SCORE ' + String(score()).padStart(5, '0'), W - 12, 20);
+			ctx.fillStyle = C.hudDim; ctx.fillText('BEST ' + String(hiscore).padStart(5, '0'), W - 12, 36);
+			if (state !== 'run') {
+				ctx.textAlign = 'center'; ctx.fillStyle = C.white; ctx.font = 'bold 18px ui-monospace, monospace';
+				ctx.fillText(state === 'over' ? 'GAME OVER' : state === 'paused' ? 'PAUSED' : 'BUG RUNNER', W / 2, H * 0.34);
+				ctx.font = '12px ui-monospace, monospace'; ctx.fillStyle = C.hud;
+				ctx.fillText(state === 'paused' ? 'Tap or press space to go on' : 'Tap or press space to ' + (state === 'over' ? 'restart' : 'start'), W / 2, H * 0.34 + 20);
+			}
+		}
+		function draw() {
+			if (!cat) reset();
+			ctx.setTransform(dpr * scale, 0, 0, dpr * scale, 0, 0);
+			ctx.imageSmoothingEnabled = false;
+			ctx.save(); if (shake > 0) ctx.translate((Math.random() - 0.5) * 6, 0);
+			drawScene();
+			coins.forEach(drawCoin);
+			obs.forEach(function (o) { if (o.k === 'bug') drawBug(o); else if (o.k === 'rack') drawRack(o); else drawGlitch(o); });
+			drawCat(cat.x, cat.y, state === 'over');
+			sparks.forEach(function (s) { px(s.x, s.y, 3, 3, s.c); });
+			hud();
+			ctx.restore();
+		}
+		function loop(now) {
+			if (state !== 'run') return;
+			var dt = Math.min(0.033, (now - last) / 1000); last = now;
+			step(dt);
+			if (state === 'run') { draw(); paintScore(); raf = requestAnimationFrame(loop); }
+		}
+
+		reset(); resize(); paintScore();
+		if (window.ResizeObserver) new ResizeObserver(function () { resize(); }).observe(box);
+		else window.addEventListener('resize', resize);
+		box.classList.add('is-ready');
+	}
+
+	function init() { document.querySelectorAll('[data-runner]').forEach(mount); }
+	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
+	window.VSRunner = { mount: mount };
+})();
diff --git a/wp-content/themes/vitalstack/assets/js/session.js b/wp-content/themes/vitalstack/assets/js/session.js
new file mode 100644
index 0000000..4853d17
--- /dev/null
+++ b/wp-content/themes/vitalstack/assets/js/session.js
@@ -0,0 +1,71 @@
+/* One device at a time (4.20.0): popups, and checking from open pages. */
+(function () {
+	'use strict';
+	var last = null;
+	function open(d) {
+		last = document.activeElement;
+		document.documentElement.classList.add('vss-open');
+		var b = d.querySelector('.vss-go');
+		if (b) setTimeout(function () { b.focus(); }, 30);
+	}
+	function close(d) {
+		d.remove();
+		if (!document.querySelector('[data-vss]')) document.documentElement.classList.remove('vss-open');
+		if (last && last.focus) last.focus();
+	}
+	function wire(d) {
+		d.querySelectorAll('[data-vss-close]').forEach(function (a) {
+			a.addEventListener('click', function (e) {
+				if (a.getAttribute('href') === '#') { e.preventDefault(); close(d); }
+			});
+		});
+		d.addEventListener('keydown', function (e) {
+			if (e.key === 'Escape' && d.getAttribute('data-vss') === 'here') close(d);
+			if (e.key === 'Tab') { // keep focus inside the popup
+				var f = d.querySelectorAll('a[href], button'); if (!f.length) return;
+				var first = f[0], lastEl = f[f.length - 1];
+				if (e.shiftKey && document.activeElement === first) { e.preventDefault(); lastEl.focus(); }
+				else if (!e.shiftKey && document.activeElement === lastEl) { e.preventDefault(); first.focus(); }
+			}
+		});
+		open(d);
+	}
+	document.querySelectorAll('[data-vss]').forEach(wire);
+
+	/* Pages that stay open: ask whether this device is still signed in. */
+	var tpl = document.getElementById('vss-out-tpl');
+	if (!tpl || !window.fetch) return;
+	var busy = false, done = false, lastPing = Date.now();
+	function el(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text) e.textContent = text; return e; }
+	function showOut(k) {
+		done = true;
+		var d = el('div', 'vss'); d.setAttribute('data-vss', 'out'); d.setAttribute('role', 'dialog'); d.setAttribute('aria-modal', 'true'); d.setAttribute('aria-labelledby', 'vss-title-live');
+		var c = el('div', 'vss-card');
+		var icon = el('p', 'vss-icon', '👋'); icon.setAttribute('aria-hidden', 'true'); c.appendChild(icon);
+		var h = el('h2', 'vss-title', tpl.getAttribute('data-title')); h.id = 'vss-title-live'; c.appendChild(h);
+		// "…signed in on %1$s %2$s…": the device in bold, built from text nodes only.
+		var p = el('p', 'vss-text'), parts = tpl.getAttribute('data-text').split('%1$s');
+		p.appendChild(document.createTextNode(parts[0]));
+		p.appendChild(el('b', '', k.by || ''));
+		p.appendChild(document.createTextNode((parts[1] || '').replace('%2$s', k.ago || '')));
+		c.appendChild(p);
+		c.appendChild(el('p', 'vss-text', tpl.getAttribute('data-text2')));
+		var a = el('div', 'vss-actions');
+		var go = el('a', 'btn btn-primary vss-go', tpl.getAttribute('data-go')); go.href = tpl.getAttribute('data-signin'); a.appendChild(go);
+		var lk = el('a', 'vss-link', tpl.getAttribute('data-link')); lk.href = tpl.getAttribute('data-reset'); a.appendChild(lk);
+		c.appendChild(a); d.appendChild(c); document.body.appendChild(d); wire(d);
+	}
+	function ping() {
+		if (busy || done || document.hidden) return;
+		busy = true; lastPing = Date.now();
+		fetch(tpl.getAttribute('data-ping'), { credentials: 'same-origin', cache: 'no-store' })
+			.then(function (r) { return r.ok ? r.json() : null; })
+			.then(function (j) { if (j && !j.in && j.kicked) showOut(j.kicked); })
+			.catch(function () {})
+			.then(function () { busy = false; });
+	}
+	setInterval(ping, 90000);
+	function soon() { if (Date.now() - lastPing > 15000) ping(); }
+	document.addEventListener('visibilitychange', function () { if (!document.hidden) soon(); });
+	window.addEventListener('focus', soon);
+})();
diff --git a/wp-content/themes/vitalstack/assets/js/share.js b/wp-content/themes/vitalstack/assets/js/share.js
