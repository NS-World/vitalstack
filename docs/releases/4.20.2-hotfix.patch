+    cout << minMeetingRooms({{7, 10}, {2, 4}}) << "\n";             // 1
+    cout << minMeetingRooms({{1, 5}, {2, 6}, {3, 7}}) << "\n";      // 3
+    cout << minMeetingRooms({}) << "\n";                            // 0
