+function dailyTemperatures(temps) {
+  const out = new Array(temps.length).fill(0);
+  const waiting = [];                         // indexes, temps decreasing
+  temps.forEach((t, i) => {
+    while (waiting.length && temps[waiting.at(-1)] < t) {
+      const j = waiting.pop();
+      out[j] = i - j;                         // day j finally got a warmer day
+    }
+    waiting.push(i);
+  });
+  return out;
+}
