+function permute(nums) {
+  const out = [], current = [], used = new Array(nums.length).fill(false);
+  const fill = () => {
+    if (current.length === nums.length) {
+      out.push([...current]);
+      return;
+    }
+    nums.forEach((x, i) => {
+      if (!used[i]) {
+        used[i] = true;
+        current.push(x);         // choose
+        fill();                  // explore
+        current.pop();           // un-choose
+        used[i] = false;
+      }
+    });
+  };
+  fill();
+  return out;
+}
+
