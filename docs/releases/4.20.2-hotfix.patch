diff --git a/wp-content/themes/vitalstack/inc/lesson-charts.php b/wp-content/themes/vitalstack/inc/lesson-charts.php
new file mode 100644
index 0000000..74237a1
--- /dev/null
+++ b/wp-content/themes/vitalstack/inc/lesson-charts.php
@@ -0,0 +1,85 @@
+<?php
+/**
+ * Charts and diagrams in the data science lessons (4.18.0).
+ *
+ * Statistics, Machine Learning, EDA, ML in Depth, Time Series, Deep
+ * Learning, NumPy and pandas lessons each gained a "See it as a chart"
+ * section: a real chart drawn by the lesson's own tested Python code. The
+ * four shortest interview problems gained a "Common mistakes and edge cases"
+ * section the same way.
+ *
+ * The sections live in data/lesson-charts.php (built from the lesson files
+ * by tools/build_lesson_charts.py). This filter adds each one to its lesson,
+ * before the heading it belongs above (normally "Summary"), so lessons that
+ * were imported before the charts existed get them straight away. A lesson
+ * that already shows the figure (imported later, or edited by hand) is left
+ * as it is, so nothing is ever doubled. The database is never changed.
+ *
+ * @package VitalStack
+ */
+
+defined( 'ABSPATH' ) || exit;
+
+function vitalstack_lesson_charts() {
+	static $c = null;
+	if ( null === $c ) {
+		$file = VITALSTACK_DIR . '/data/lesson-charts.php';
+		$c    = file_exists( $file ) ? (array) include $file : array();
+	}
+	return $c;
+}
+
+/**
+ * The lesson being rendered. The protected premium lesson API renders a
+ * lesson with setup_postdata(), which fires "the_post" but does not set the
+ * global post, so the post is remembered from that action too.
+ */
+function vitalstack_lesson_charts_post( $set = null ) {
+	static $current = null;
+	if ( $set instanceof WP_Post ) {
+		$current = $set;
+	}
+	return $current;
+}
+add_action(
+	'the_post',
+	function ( $post ) {
+		vitalstack_lesson_charts_post( $post );
+	}
+);
+
+/** Add the missing chart sections to one lesson's raw block content. */
+function vitalstack_lesson_charts_apply( $content, $slug ) {
+	$items = vitalstack_lesson_charts()[ $slug ] ?? array();
+	foreach ( $items as $item ) {
+		if ( false !== strpos( $content, $item['figure'] ) ) {
+			continue; // already in the lesson ('figure' is the chart file, or a text section's heading)
+		}
+		$at = false;
+		if ( '' !== $item['before'] && preg_match( '#<!-- wp:heading[^>]*-->\s*<h2\b[^>]*>\s*' . preg_quote( esc_html( $item['before'] ), '#' ) . '\s*</h2>#', $content, $m, PREG_OFFSET_CAPTURE ) ) {
+			$at = $m[0][1];
+		} elseif ( '' !== $item['before'] && preg_match( '#<h2\b[^>]*>\s*' . preg_quote( esc_html( $item['before'] ), '#' ) . '\s*</h2>#', $content, $m, PREG_OFFSET_CAPTURE ) ) {
+			$at = $m[0][1];
+		}
+		$block   = $item['html'] . "\n\n";
+		$content = false === $at ? rtrim( $content ) . "\n\n" . $block : substr( $content, 0, $at ) . $block . substr( $content, $at );
+	}
+	return $content;
+}
+
+function vitalstack_lesson_charts_filter( $content ) {
+	if ( is_feed() ) {
+		return $content;
+	}
+	$post = get_post();
+	$seen = vitalstack_lesson_charts_post();
+	if ( ! empty( $GLOBALS['vitalstack_protect_raw'] ) && $seen ) {
+		$post = $seen; // the protected lesson API
+	}
+	if ( ! $post || 'tutorials' !== $post->post_type || ! isset( vitalstack_lesson_charts()[ $post->post_name ] ) ) {
+		return $content;
+	}
+	return vitalstack_lesson_charts_apply( $content, $post->post_name );
+}
+// Priority 8: before blocks (9) and shortcodes (11) render, so the sections are rendered exactly like the rest of the lesson.
+add_filter( 'the_content', 'vitalstack_lesson_charts_filter', 8 );
diff --git a/wp-content/themes/vitalstack/inc/mail-fallback.php b/wp-content/themes/vitalstack/inc/mail-fallback.php
new file mode 100644
index 0000000..4045ae7
--- /dev/null
+++ b/wp-content/themes/vitalstack/inc/mail-fallback.php
@@ -0,0 +1,113 @@
+<?php
+/**
+ * 4.20.1: sign-in codes keep arriving even when an SMTP plugin is set up wrong.
+ *
+ * If a theme email (sign-in / sign-up code, receipts, lesson emails) fails
+ * through an SMTP plugin (wrong password, wrong port, From address the
+ * mailbox does not own), it is sent once more with the server's built-in
+ * mail, the way it went before the SMTP plugin was installed. The SMTP
+ * error is saved and shown to admins so the setting can be fixed.
+ *
+ * @package VitalStack
+ */
+
+defined( 'ABSPATH' ) || exit;
+
+const VITALSTACK_MAIL_ERR_OPT = 'vitalstack_mail_error';
+
+/**
+ * Remember why the last email failed (admins only ever see it).
+ *
+ * @param WP_Error $error From wp_mail().
+ */
+function vitalstack_mail_record_error( $error ) {
+	if ( ! is_wp_error( $error ) ) {
+		return;
+	}
+	$msg = wp_strip_all_tags( (string) $error->get_error_message() );
+	// Never store anything that looks like a password or an address list.
+	$msg = preg_replace( '/[^\s@]+@[^\s@]+/', '[email]', $msg );
+	$old = get_option( VITALSTACK_MAIL_ERR_OPT );
+	update_option(
+		VITALSTACK_MAIL_ERR_OPT,
+		array(
+			't'        => time(),
+			'msg'      => mb_substr( $msg, 0, 300 ),
+			'smtp'     => function_exists( 'vitalstack_mail_smtp_plugin' ) ? vitalstack_mail_smtp_plugin() : '',
+			'fallback' => is_array( $old ) && isset( $old['fallback'] ) ? (int) $old['fallback'] : 0,
+			'retrying' => ! empty( $GLOBALS['vitalstack_mail_retrying'] ),
+		),
+		false
+	);
+}
+add_action( 'wp_mail_failed', 'vitalstack_mail_record_error' );
+
+/**
+ * A normal (non-backup) send worked again: the SMTP setting is fixed, so
+ * the admin warning goes away by itself.
+ */
+function vitalstack_mail_clear_error() {
+	if ( empty( $GLOBALS['vitalstack_mail_retrying'] ) && false !== get_option( VITALSTACK_MAIL_ERR_OPT ) ) {
+		delete_option( VITALSTACK_MAIL_ERR_OPT );
+	}
+}
+add_action( 'wp_mail_succeeded', 'vitalstack_mail_clear_error' );
+
+/** Switches this one send to the server's built-in mail. */
+function vitalstack_mail_force_builtin( $phpmailer ) {
+	$phpmailer->isMail();
+	if ( empty( $phpmailer->Sender ) && is_email( $phpmailer->From ) ) {
+		$phpmailer->Sender = $phpmailer->From;
+	}
+}
+
+/**
+ * Called by vitalstack_mail() when wp_mail() returned false.
+ * Retries once with built-in mail, only when an SMTP plugin is active
+ * (without one, built-in mail already failed and a retry would not help).
+ *
+ * @return bool Whether the backup send worked.
+ */
+function vitalstack_mail_retry( $to, $subject, $html, $headers ) {
+	static $busy = false;
+	$smtp = function_exists( 'vitalstack_mail_smtp_plugin' ) ? vitalstack_mail_smtp_plugin() : '';
+	if ( $busy || '' === $smtp || ! apply_filters( 'vitalstack_mail_fallback', true, $to ) ) {
+		return false;
+	}
+	$busy                                = true;
+	$GLOBALS['vitalstack_mail_retrying'] = true;
+	add_action( 'phpmailer_init', 'vitalstack_mail_force_builtin', PHP_INT_MAX );
+	$sent = wp_mail( $to, $subject, $html, $headers );
+	remove_action( 'phpmailer_init', 'vitalstack_mail_force_builtin', PHP_INT_MAX );
+	$GLOBALS['vitalstack_mail_retrying'] = false;
+	$busy                                = false;
+	if ( $sent ) {
+		$err = get_option( VITALSTACK_MAIL_ERR_OPT );
+		if ( is_array( $err ) ) {
+			$err['fallback'] = ( isset( $err['fallback'] ) ? (int) $err['fallback'] : 0 ) + 1;
+			update_option( VITALSTACK_MAIL_ERR_OPT, $err, false );
+		}
+	}
+	return $sent;
+}
+
+/** Admin warning while the SMTP plugin is failing. */
+function vitalstack_mail_error_notice() {
+	if ( ! current_user_can( 'manage_options' ) ) {
+		return;
+	}
+	$err = get_option( VITALSTACK_MAIL_ERR_OPT );
+	if ( ! is_array( $err ) || empty( $err['t'] ) || time() - (int) $err['t'] > 7 * DAY_IN_SECONDS ) {
+		return;
+	}
+	$when = human_time_diff( (int) $err['t'], time() );
+	echo '<div class="notice notice-error"><p><strong>' . esc_html__( 'VitalStack: emails are failing through your SMTP plugin.', 'vitalstack' ) . '</strong> ';
+	/* translators: 1: plugin name, 2: time ago, 3: error text */
+	echo esc_html( sprintf( __( '%1$s could not send an email %2$s ago: "%3$s".', 'vitalstack' ), $err['smtp'] ? $err['smtp'] : __( 'The mail system', 'vitalstack' ), $when, $err['msg'] ) ) . '</p>';
+	if ( ! empty( $err['fallback'] ) ) {
+		/* translators: %d: number of emails */
+		echo '<p>' . esc_html( sprintf( _n( 'So readers were not blocked, %d email (sign-in codes etc.) was sent with the server’s built-in mail instead. That works, but can land in spam more often.', 'So readers were not blocked, %d emails (sign-in codes etc.) were sent with the server’s built-in mail instead. That works, but can land in spam more often.', (int) $err['fallback'], 'vitalstack' ), (int) $err['fallback'] ) ) . '</p>';
+	}
+	echo '<p>' . esc_html__( 'Fix: open the SMTP plugin settings and check the SMTP host, port + encryption (smtp.hostinger.com, 465 + SSL), the username (the full mailbox address), its password, and that the From email is that same mailbox. Then send a test email. This warning disappears after the next email goes through normally.', 'vitalstack' ) . '</p></div>';
+}
+add_action( 'admin_notices', 'vitalstack_mail_error_notice' );
diff --git a/wp-content/themes/vitalstack/inc/mail-health.php b/wp-content/themes/vitalstack/inc/mail-health.php
new file mode 100644
index 0000000..0ecde1a
--- /dev/null
+++ b/wp-content/themes/vitalstack/inc/mail-health.php
@@ -0,0 +1,264 @@
+<?php
+/**
+ * Email delivery (4.14.1): keep site emails out of spam.
+ *
+ *   - Every email the theme sends gets a plain-text part next to the HTML
+ *     (HTML-only mail is a spam signal), a Message-ID on the sender's own
+ *     domain, and, when no SMTP plugin is active, a Return-Path that matches
+ *     the From address (needed for SPF/DMARC alignment).
+ *   - Tools → Email check: looks up the domain's SPF, DKIM, DMARC and MX
+ *     records from this server, spots a missing SMTP plugin or a From
+ *     address on another domain, and sends a test email (for example to
+ *     mail-tester.com for a spam score).
+ *   - Admins see a dashboard warning while something important is red.
+ *
+ * @package VitalStack
+ */
+
+defined( 'ABSPATH' ) || exit;
+
+/** Plain text from the theme's email HTML: links become "text (url)". */
+function vitalstack_mail_text( $html ) {
+	$t = preg_replace( '#<(script|style|head)\b[^>]*>.*?</\1>#is', '', (string) $html );
+	$t = preg_replace_callback(
+		'#<a\s[^>]*href=("|\')(.*?)\1[^>]*>(.*?)</a>#is',
+		function ( $m ) {
+			$label = trim( wp_strip_all_tags( $m[3] ) );
+			$url   = html_entity_decode( $m[2], ENT_QUOTES, 'UTF-8' );
+			return ( '' === $label || $label === $url ) ? $url : $label . ' (' . $url . ')';
+		},
+		$t
+	);
+	$t = preg_replace( '#<(br|/p|/li|/h[1-6]|/tr|/table|/div)\b[^>]*>#i', "\n", $t );
+	$t = preg_replace( '#<li\b[^>]*>#i', '- ', $t );
+	$t = html_entity_decode( wp_strip_all_tags( $t ), ENT_QUOTES, 'UTF-8' );
+	$t = preg_replace( "/[ \t]+/", ' ', $t );
+	$t = preg_replace( "/\n\s*\n\s*\n+/", "\n\n", $t );
+	return trim( implode( "\n", array_map( 'trim', explode( "\n", $t ) ) ) );
+}
+
+/** Whether an SMTP plugin (or a mailer service) handles WordPress mail. */
+function vitalstack_mail_smtp_plugin() {
+	$known = array(
+		'wp-mail-smtp/wp_mail_smtp.php'          => 'WP Mail SMTP',
+		'wp-mail-smtp-pro/wp_mail_smtp.php'      => 'WP Mail SMTP Pro',
+		'fluent-smtp/fluent-smtp.php'            => 'FluentSMTP',
+		'post-smtp/postman-smtp.php'             => 'Post SMTP',
+		'easy-wp-smtp/easy-wp-smtp.php'          => 'Easy WP SMTP',
+		'smtp-mailer/main.php'                   => 'SMTP Mailer',
+		'gosmtp/gosmtp.php'                      => 'GoSMTP',
+		'mailgun/mailgun.php'                    => 'Mailgun',
+		'sendgrid-email-delivery-simplified/wpsendgrid.php' => 'SendGrid',
+		'brevo/brevo.php'                        => 'Brevo',
+		'mailin/sendinblue.php'                  => 'Brevo (Sendinblue)',
+	);
+	$active = (array) get_option( 'active_plugins', array() );
+	foreach ( $known as $file => $name ) {
+		if ( in_array( $file, $active, true ) ) {
+			return $name;
+		}
+	}
+	return (string) apply_filters( 'vitalstack_mail_smtp_plugin', '' );
+}
+
+function vitalstack_mail_domain_of( $email ) {
+	$at = strrpos( (string) $email, '@' );
+	return false === $at ? '' : strtolower( substr( $email, $at + 1 ) );
+}
+
+function vitalstack_mail_site_domain() {
+	return preg_replace( '/^www\./', '', strtolower( (string) wp_parse_url( home_url( '/' ), PHP_URL_HOST ) ) );
+}
+
+/** The From address WordPress will use for theme emails. */
+function vitalstack_mail_from() {
+	return apply_filters( 'wp_mail_from', 'wordpress@' . vitalstack_mail_site_domain() );
+}
+
+/**
+ * Applied to every theme email: plain-text part, Message-ID and Return-Path.
+ * Hooked only while vitalstack_mail() sends, so other plugins' mail is untouched.
+ */
+function vitalstack_mail_prepare( $phpmailer ) {
+	if ( empty( $phpmailer->AltBody ) && ! empty( $phpmailer->Body ) ) {
+		$phpmailer->AltBody = vitalstack_mail_text( $phpmailer->Body );
+	}
+	$domain = vitalstack_mail_domain_of( $phpmailer->From );
+	if ( $domain && preg_match( '/^[a-z0-9.-]+$/', $domain ) ) {
+		$phpmailer->MessageID = '<' . bin2hex( random_bytes( 12 ) ) . '.' . time() . '@' . $domain . '>';
+	}
+	// With PHP mail() the envelope sender defaults to the server account; match it to From.
+	if ( 'mail' === $phpmailer->Mailer && empty( $phpmailer->Sender ) && is_email( $phpmailer->From ) ) {
+		$phpmailer->Sender = $phpmailer->From;
+	}
+}
+
+/* ── Checks ───────────────────────────────────────────────────────────── */
+
+function vitalstack_mail_txt( $name ) {
+	if ( ! function_exists( 'dns_get_record' ) ) {
+		return null;
+	}
+	$out = array();
+	$rec = @dns_get_record( $name, DNS_TXT ); // phpcs:ignore WordPress.PHP.NoSilencedErrors -- missing records are normal
+	foreach ( (array) $rec as $r ) {
+		if ( isset( $r['txt'] ) ) {
+			$out[] = $r['txt'];
+		} elseif ( isset( $r['entries'] ) ) {
+			$out[] = implode( '', $r['entries'] );
+		}
+	}
+	return $out;
+}
+
+/** [ key => [status ok|warn|bad|info, title, detail, fix] ]. */
+function vitalstack_mail_checks() {
+	$from   = vitalstack_mail_from();
+	$fd     = vitalstack_mail_domain_of( $from );
+	$site   = vitalstack_mail_site_domain();
+	$smtp   = vitalstack_mail_smtp_plugin();
+	$checks = array();
+
+	$checks['smtp'] = $smtp
+		? array( 'ok', __( 'SMTP plugin', 'vitalstack' ), sprintf( /* translators: %s: plugin */ __( '%s is active: emails go through a real mail server.', 'vitalstack' ), $smtp ), '' )
+		: array( 'bad', __( 'SMTP plugin', 'vitalstack' ), __( 'No SMTP plugin found. WordPress sends with PHP mail(), which Gmail and Outlook often put in spam.', 'vitalstack' ), __( 'Create the mailbox in hPanel → Emails (for example contact@ your domain), install "WP Mail SMTP" or "FluentSMTP", choose "Other SMTP": host smtp.hostinger.com, port 465, SSL, your full email as username and its password.', 'vitalstack' ) );
+
+	$same = $fd && ( $fd === $site || substr( $site, -strlen( '.' . $fd ) ) === '.' . $fd );
+	$checks['from'] = $same
+		? array( 'ok', __( 'From address', 'vitalstack' ), sprintf( /* translators: %s: email */ __( 'Emails come from %s, on this site’s own domain.', 'vitalstack' ), $from ), '' )
+		: array( $smtp ? 'warn' : 'bad', __( 'From address', 'vitalstack' ), sprintf( /* translators: 1: email, 2: domain */ __( 'Emails say they come from %1$s, but this site is %2$s. Without an SMTP login for that address, mail providers treat this as spoofing and use spam.', 'vitalstack' ), $from, $site ), __( 'Send through SMTP with a mailbox of the From domain. On a test copy of the site (UAT), expect some mail in spam unless it uses the same SMTP login.', 'vitalstack' ) );
+
+	if ( ! function_exists( 'dns_get_record' ) ) {
+		$checks['dns'] = array( 'info', __( 'DNS records', 'vitalstack' ), __( 'This server can’t look up DNS records. Check them with a free tool such as mxtoolbox.com.', 'vitalstack' ), '' );
+		return $checks;
+	}
+	$spf = array_values( array_filter( (array) vitalstack_mail_txt( $fd ), function ( $t ) { return 0 === stripos( $t, 'v=spf1' ); } ) );
+	if ( ! $spf ) {
+		$checks['spf'] = array( 'bad', 'SPF', sprintf( /* translators: %s: domain */ __( 'No SPF record on %s.', 'vitalstack' ), $fd ), __( 'hPanel → Domains → DNS: add a TXT record, name @, value: v=spf1 include:_spf.mail.hostinger.com ~all (add other senders you use inside the same record).', 'vitalstack' ) );
+	} elseif ( count( $spf ) > 1 ) {
+		$checks['spf'] = array( 'bad', 'SPF', __( 'More than one SPF record: that makes SPF fail.', 'vitalstack' ) . ' ' . implode( ' | ', $spf ), __( 'Merge them into one TXT record that starts with v=spf1.', 'vitalstack' ) );
+	} else {
+		$h = false !== stripos( $spf[0], 'hostinger' );
+		$checks['spf'] = array( $h || $smtp ? 'ok' : 'warn', 'SPF', $spf[0], $h ? '' : __( 'If you send through Hostinger email, the record should include include:_spf.mail.hostinger.com. Include whichever service your SMTP plugin uses.', 'vitalstack' ) );
+	}
+	$dkim = array();
+	foreach ( array( 'hostingermail-a', 'hostingermail-b', 'hostingermail-c', 'hostingermail1', 'hostingermail2', 'default', 'google', 'k1', 's1', 'mail' ) as $sel ) {
+		$name = $sel . '._domainkey.' . $fd;
+		$txt  = (array) vitalstack_mail_txt( $name );
+		$cn   = @dns_get_record( $name, DNS_CNAME ); // phpcs:ignore WordPress.PHP.NoSilencedErrors
+		if ( array_filter( $txt, function ( $t ) { return false !== stripos( $t, 'p=' ); } ) || ! empty( $cn ) ) {
+			$dkim[] = $sel;
+		}
+	}
+	$checks['dkim'] = $dkim
+		? array( 'ok', 'DKIM', sprintf( /* translators: %s: selectors */ __( 'DKIM key found (selector: %s).', 'vitalstack' ), implode( ', ', $dkim ) ), '' )
+		: array( 'bad', 'DKIM', __( 'No DKIM key found for the usual selectors.', 'vitalstack' ), __( 'hPanel → Emails → your domain → DNS settings (or "Email authentication"): add the three DKIM CNAME records Hostinger shows (hostingermail-a/b/c._domainkey). Other providers show their own.', 'vitalstack' ) );
+	$dm = array_values( array_filter( (array) vitalstack_mail_txt( '_dmarc.' . $fd ), function ( $t ) { return 0 === stripos( $t, 'v=DMARC1' ); } ) );
+	$checks['dmarc'] = $dm
+		? array( 'ok', 'DMARC', $dm[0], '' )
+		: array( 'bad', 'DMARC', sprintf( /* translators: %s: domain */ __( 'No DMARC record on %s. Gmail and Yahoo require one for bulk senders.', 'vitalstack' ), $fd ), __( 'Add a TXT record, name _dmarc, value: v=DMARC1; p=none; rua=mailto:your-address@your-domain (move to p=quarantine once everything passes).', 'vitalstack' ) );
+	$mx = @dns_get_record( $fd, DNS_MX ); // phpcs:ignore WordPress.PHP.NoSilencedErrors
+	$checks['mx'] = ! empty( $mx )
+		? array( 'ok', __( 'Mailbox (MX)', 'vitalstack' ), implode( ', ', wp_list_pluck( $mx, 'target' ) ), '' )
+		: array( 'warn', __( 'Mailbox (MX)', 'vitalstack' ), __( 'No MX record: replies to your emails can’t arrive, and some filters distrust domains that can’t receive mail.', 'vitalstack' ), __( 'Create the mailbox in hPanel → Emails; Hostinger adds the MX records.', 'vitalstack' ) );
+	return $checks;
+}
+
+/** Cached for the dashboard notice (12 hours). */
+function vitalstack_mail_checks_cached() {
+	$c = get_transient( 'vs_mail_checks' );
+	if ( ! is_array( $c ) ) {
+		$c = vitalstack_mail_checks();
+		set_transient( 'vs_mail_checks', $c, 12 * HOUR_IN_SECONDS );
+	}
+	return $c;
+}
+
+/* ── Tools → Email check ──────────────────────────────────────────────── */
+
+add_action(
+	'admin_menu',
+	function () {
+		add_management_page( __( 'Email check', 'vitalstack' ), __( 'Email check', 'vitalstack' ), 'manage_options', 'vitalstack-email-check', 'vitalstack_mail_page' );
+	}
+);
+
+function vitalstack_mail_page() {
+	if ( ! current_user_can( 'manage_options' ) ) {
+		return;
+	}
+	$msg = '';
+	if ( isset( $_POST['vs_mail_test'] ) ) {
+		check_admin_referer( 'vs_mail_test' );
+		$to = sanitize_email( wp_unslash( $_POST['vs_mail_to'] ?? '' ) );
+		if ( ! is_email( $to ) ) {
+			$msg = __( 'Please enter a valid email address.', 'vitalstack' );
+		} else {
+			$body = '<p>' . esc_html__( 'This is a test email from your VitalStack site.', 'vitalstack' ) . '</p><p>' . esc_html__( 'If it arrived in your inbox (not spam), email delivery is working.', 'vitalstack' ) . '</p>' . vitalstack_email_button( home_url( '/' ), __( 'Open VitalStack', 'vitalstack' ) );
+			$ok   = vitalstack_mail( $to, __( 'Test email from VitalStack', 'vitalstack' ), $body );
+			/* translators: %s: email */
+			$msg = $ok ? sprintf( __( 'Test email sent to %s.', 'vitalstack' ), $to ) : __( 'WordPress could not send the email. Check the SMTP plugin settings.', 'vitalstack' );
+		}
+	}
+	if ( isset( $_GET['recheck'] ) ) { // phpcs:ignore WordPress.Security.NonceVerification -- read-only refresh
+		delete_transient( 'vs_mail_checks' );
+	}
+	$checks = vitalstack_mail_checks();
+	set_transient( 'vs_mail_checks', $checks, 12 * HOUR_IN_SECONDS );
+	$icon = array( 'ok' => '✅', 'warn' => '⚠️', 'bad' => '❌', 'info' => 'ℹ️' );
+	?>
+	<div class="wrap">
+		<h1><?php esc_html_e( 'Email check', 'vitalstack' ); ?></h1>
+		<p><?php esc_html_e( 'Sign-up codes, receipts and lesson emails reach the inbox only when all of these are green. Fix the red ones first.', 'vitalstack' ); ?></p>
+		<?php if ( $msg ) : ?><div class="notice notice-info is-dismissible"><p><?php echo esc_html( $msg ); ?></p></div><?php endif; ?>
+		<table class="widefat striped" style="max-width:980px"><tbody>
+			<?php foreach ( $checks as $c ) : ?>
+				<tr>
+					<td style="width:34px;font-size:18px"><?php echo esc_html( $icon[ $c[0] ] ); ?></td>
+					<td style="width:150px"><b><?php echo esc_html( $c[1] ); ?></b></td>
+					<td><code style="white-space:normal;word-break:break-all"><?php echo esc_html( $c[2] ); ?></code><?php if ( $c[3] ) : ?><p style="margin:6px 0 0"><b><?php esc_html_e( 'Fix:', 'vitalstack' ); ?></b> <?php echo esc_html( $c[3] ); ?></p><?php endif; ?></td>
+				</tr>
+			<?php endforeach; ?>
+		</tbody></table>
+		<p><a class="button" href="<?php echo esc_url( add_query_arg( 'recheck', 1 ) ); ?>"><?php esc_html_e( 'Check again', 'vitalstack' ); ?></a> <span class="description"><?php esc_html_e( 'DNS changes can take up to a few hours to show.', 'vitalstack' ); ?></span></p>
+		<h2><?php esc_html_e( 'Send a test email', 'vitalstack' ); ?></h2>
+		<p><?php esc_html_e( 'Tip: open mail-tester.com, copy the address it shows, send the test there, and it gives a spam score out of 10 with the exact problems. Aim for 9 or more.', 'vitalstack' ); ?></p>
+		<form method="post">
+			<?php wp_nonce_field( 'vs_mail_test' ); ?>
+			<input type="email" name="vs_mail_to" class="regular-text" required placeholder="test-xxxx@srv1.mail-tester.com">
+			<?php submit_button( __( 'Send test', 'vitalstack' ), 'primary', 'vs_mail_test', false ); ?>
+		</form>
+		<h2><?php esc_html_e( 'Also helps', 'vitalstack' ); ?></h2>
+		<ul style="list-style:disc;padding-left:20px">
+			<li><?php esc_html_e( 'Ask testers to mark your first emails "Not spam" and add the address to contacts.', 'vitalstack' ); ?></li>
+			<li><?php esc_html_e( 'Start marketing emails slowly (a few dozen a day) so the new domain builds a good reputation.', 'vitalstack' ); ?></li>
+			<li><?php esc_html_e( 'Use Google Postmaster Tools (postmaster.google.com) to watch your domain reputation with Gmail.', 'vitalstack' ); ?></li>
+		</ul>
+	</div>
+	<?php
+}
+
+/* ── Dashboard warning while something important is red ───────────────── */
+
+add_action(
+	'admin_notices',
+	function () {
+		if ( ! current_user_can( 'manage_options' ) || ( isset( $_GET['page'] ) && 'vitalstack-email-check' === $_GET['page'] ) ) { // phpcs:ignore WordPress.Security.NonceVerification
+			return;
+		}
+		$screen = function_exists( 'get_current_screen' ) ? get_current_screen() : null;
+		if ( ! $screen || ! in_array( $screen->id, array( 'dashboard', 'plugins', 'settings_page_vitalstack-marketing' ), true ) ) {
+			return;
+		}
+		$bad = array();
+		foreach ( vitalstack_mail_checks_cached() as $c ) {
+			if ( 'bad' === $c[0] ) {
+				$bad[] = $c[1];
+			}
+		}
+		if ( ! $bad ) {
+			return;
+		}
+		echo '<div class="notice notice-warning"><p><b>' . esc_html__( 'Your emails may land in spam.', 'vitalstack' ) . '</b> ' . esc_html( sprintf( /* translators: %s: list */ __( 'Needs fixing: %s.', 'vitalstack' ), implode( ', ', $bad ) ) ) . ' <a href="' . esc_url( admin_url( 'tools.php?page=vitalstack-email-check' ) ) . '">' . esc_html__( 'Open Email check', 'vitalstack' ) . ' →</a></p></div>';
+	}
+);
diff --git a/wp-content/themes/vitalstack/inc/module-guides.php b/wp-content/themes/vitalstack/inc/module-guides.php
new file mode 100644
index 0000000..2029d10
--- /dev/null
+++ b/wp-content/themes/vitalstack/inc/module-guides.php
@@ -0,0 +1,117 @@
+<?php
+/**
+ * Module guides on premium lessons (4.15.0).
+ *
+ * Every premium lesson (and, from 4.16.0, every lesson of the free data and
+ * AI paths) opens with a "Module guide" card: a short history of
+ * the tool or idea, how it works step by step, where to run it, and what it
+ * is used for at work. It is open on the module's first lesson and folded
+ * (one tap to open) on the others. It is shown to everyone, including
+ * readers without access, as a preview of what the module covers.
+ *
+ * The content lives in data/module-guides.php, so it reaches lessons that
+ * are already on the site without re-importing them.
+ *
+ * @package VitalStack
+ */
+
+defined( 'ABSPATH' ) || exit;
+
+function vitalstack_module_guides() {
+	static $g = null;
+	if ( null === $g ) {
+		$file = VITALSTACK_DIR . '/data/module-guides.php';
+		$g    = file_exists( $file ) ? (array) include $file : array();
+	}
+	return $g;
+}
+
+/** Title of a module (path) inside a premium track, from the track list. */
+function vitalstack_module_guide_title( $path_slug, $track ) {
+	$tracks = function_exists( 'vitalstack_premium_tracks' ) ? vitalstack_premium_tracks() : array();
+	// The lesson's own track first, then any track (free paths belong to several).
+	$order = $track && isset( $tracks[ $track ] ) ? array_merge( array( $track => $tracks[ $track ] ), $tracks ) : $tracks;
+	foreach ( $order as $t ) {
+		foreach ( (array) ( $t['modules'] ?? array() ) as $m ) {
+			if ( ( $m['path'] ?? '' ) === $path_slug ) {
+				return $m['title'];
+			}
+		}
+	}
+	return '';
+}
+
+function vitalstack_module_guide_html( $path_slug, $track, $open = false ) {
+	$g = vitalstack_module_guides()[ $path_slug ] ?? null;
+	if ( ! $g ) {
+		return '';
+	}
+	$title = vitalstack_module_guide_title( $path_slug, $track );
+	$h     = '<details class="mg"' . ( $open ? ' open' : '' ) . '>';
+	$h    .= '<summary class="mg-sum"><span class="mg-badge">⭐ ' . esc_html__( 'Module guide', 'vitalstack' ) . '</span>'
+		. '<span class="mg-title">' . esc_html( $title ? $title : __( 'This module at a glance', 'vitalstack' ) ) . '</span>'
+		. '<span class="mg-hint">' . esc_html( ! empty( $g['history'] ) ? __( 'History · How it works · Where to run it', 'vitalstack' ) : __( 'How it works · Where to run it', 'vitalstack' ) ) . '</span></summary>';
+	$h    .= '<div class="mg-body">';
+	if ( ! empty( $g['history'] ) ) {
+		$h .= '<section class="mg-col mg-history"><p class="mg-h">📜 ' . esc_html__( 'A short history', 'vitalstack' ) . '</p><ol class="mg-time">';
+		foreach ( $g['history'] as $e ) {
+			$h .= '<li><b>' . esc_html( $e[0] ) . '</b><span>' . esc_html( $e[1] ) . '</span></li>';
+		}
+		$h .= '</ol></section>';
+	}
+	$h .= '<section class="mg-col mg-flowcol"><p class="mg-h">⚙️ ' . esc_html__( 'How it works', 'vitalstack' ) . '</p><ol class="mg-flow">';
+	foreach ( (array) ( $g['flow'] ?? array() ) as $i => $step ) {
+		$h .= '<li><span class="mg-n">' . (int) ( $i + 1 ) . '</span><span>' . esc_html( $step ) . '</span></li>';
+	}
+	$h .= '</ol></section>';
+	$h .= '<section class="mg-col mg-facts">';
+	if ( ! empty( $g['run'] ) ) {
+		$h .= '<p class="mg-h">🧰 ' . esc_html__( 'Where to run it', 'vitalstack' ) . '</p><p>' . esc_html( $g['run'] ) . '</p>';
+		$term  = 'ds-setup' === $path_slug ? null : get_term_by( 'slug', 'ds-setup', 'tutorial_category' );
+		if ( $term && ! is_wp_error( $term ) ) {
+			$link = get_term_link( $term );
+			if ( ! is_wp_error( $link ) ) {
+				$h .= '<p class="mg-small"><a href="' . esc_url( $link ) . '">' . esc_html__( 'New to Jupyter or Colab? Set up in 15 minutes', 'vitalstack' ) . ' →</a></p>';
+			}
+		}
+	}
+	if ( function_exists( 'vitalstack_study_plan_url' ) && in_array( $path_slug, array( 'ds-setup', 'python', 'numpy', 'pandas', 'data-visualization', 'statistics', 'machine-learning', 'eda' ), true ) ) {
+		$h .= '<p class="mg-small"><a href="' . esc_url( vitalstack_study_plan_url() ) . '">🗓️ ' . esc_html__( 'Follow the 30-day Data Science plan', 'vitalstack' ) . ' →</a></p>';
+	}
+	if ( ! empty( $g['used'] ) ) {
+		$h .= '<p class="mg-h">💼 ' . esc_html__( 'Used at work for', 'vitalstack' ) . '</p><p>' . esc_html( $g['used'] ) . '</p>';
+	}
+	$h .= '</section></div></details>';
+	return $h;
+}
+
+/** Whether this lesson is the first of its learning path. */
+function vitalstack_module_guide_is_first( $post_id, $path ) {
+	if ( ! function_exists( 'vitalstack_path_lessons' ) ) {
+		return false;
+	}
+	$lessons = vitalstack_path_lessons( $path );
+	if ( ! $lessons ) {
+		return false;
+	}
+	$first = reset( $lessons );
+	return (int) ( is_object( $first ) ? $first->ID : $first ) === (int) $post_id;
+}
+
+add_filter(
+	'the_content',
+	function ( $content ) {
+		if ( ! is_singular( 'tutorials' ) || ! in_the_loop() || ! is_main_query() || ! function_exists( 'vitalstack_tutorial_path' ) ) {
+			return $content;
+		}
+		// Premium modules and the free data / AI paths (4.16.0) have a guide.
+		$path  = vitalstack_tutorial_path();
+		$track = function_exists( 'vitalstack_lesson_track' ) ? vitalstack_lesson_track() : '';
+		if ( ! $path || empty( vitalstack_module_guides()[ $path->slug ] ) ) {
+			return $content;
+		}
+		$card = vitalstack_module_guide_html( $path->slug, $track, vitalstack_module_guide_is_first( get_the_ID(), $path ) );
+		return $card ? $card . $content : $content;
+	},
+	100 // after the premium gate (99), so readers with and without access see it
+);
