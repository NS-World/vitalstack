+public class Main {
+    static int subarraySum(int[] nums, int k) {
+        Map<Integer, Integer> seen = new HashMap<>();   // prefix sum -> how many times seen
+        seen.put(0, 1);
+        int total = 0, count = 0;
+        for (int x : nums) {
+            total += x;
+            count += seen.getOrDefault(total - k, 0);
+            seen.merge(total, 1, Integer::sum);
+        }
+        return count;
+    }
+
