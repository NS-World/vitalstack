+#include <algorithm>
+#include <iostream>
+#include <vector>
+using namespace std;
+
+int maxArea(const vector<int>& height) {
+    int left = 0, right = (int)height.size() - 1, best = 0;
+    while (left < right) {
+        int water = (right - left) * min(height[left], height[right]);
+        best = max(best, water);
+        if (height[left] < height[right]) left++;   // move the shorter wall
+        else right--;
+    }
+    return best;
+}
