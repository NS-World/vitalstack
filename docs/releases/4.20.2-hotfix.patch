+int numIslands(vector<string> grid) {
+    int count = 0;
+    for (int r = 0; r < (int)grid.size(); r++) {
+        for (int c = 0; c < (int)grid[0].size(); c++) {
+            if (grid[r][c] == '1') {
+                count++;
+                sink(grid, r, c);
+            }
+        }
+    }
+    return count;
+}
